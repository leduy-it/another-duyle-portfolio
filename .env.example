SITE_URL=https://another.duyle.me
# Exact additional HTTPS aliases, comma-separated. Vercel metadata names only one production domain.
SITE_ORIGINS=https://another-duyle-portfolio.vercel.app
CONTACT_PROVIDER=formsubmit
# Optional verified sender instead of the browser relay.
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
# Server-only durable storage. The namespace is separate from duyle.me.
KV_REST_API_URL=
KV_REST_API_TOKEN=
CONTACT_SECRET=
