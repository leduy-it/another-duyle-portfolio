{
  "name": "another-duyle-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Michael Le's alternate portfolio \u2014 the author's Foundable design, independently hosted.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src scripts api tests *.json *.md docs/*.md",
    "check": "node scripts/check.mjs",
    "test:motion": "node tests/motion.mjs",
    "profile:scroll": "node scripts/profile-scroll.mjs"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
